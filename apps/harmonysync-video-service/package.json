{
  "name": "@harmonysync/video-service",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone video processing service for HarmonySync",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && nodemon dist/server.js",
    "test": "jest --runInBand",
    "smoke-test": "tsc && node dist/smoke-test.js"
  },
  "keywords": [
    "video",
    "ffmpeg",
    "transcoding",
    "processing"
  ],
  "author": "HarmonySync",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.1",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.11.16",
    "@types/socket.io-client": "^3.0.0",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.3"
  },
  ,
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
  "engines": {
    "node": ">=16.0.0"
  }
}
