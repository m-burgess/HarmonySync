{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "@electron/*": [
        "./*"
      ],
      "@electron/types/*": [
        "./types/*"
      ],
      "@electron/services/*": [
        "./services/*"
      ]
    },
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "electron/**/*",
    "types/**/*",
    "main.ts",
    "preload.ts",
    "ipc-handlers.ts"
  ],
  "references": []
}