{
  "name": "@harmonysync/electron-app",
  "description": "HarmonySync Electron main process and desktop application",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:build\" \"pnpm run dev:electron\"",
    "dev:build": "tsc -b --watch",
    "dev:electron": "wait-on tcp:4200 && cross-env NODE_ENV=development electron dist/main.js",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "jest --config=jest.config.electron.js --passWithNoTests --detectOpenHandles"
  },
  "dependencies": {
    "@harmonysync/core": "workspace:*",
    "@types/unzipper": "^0.10.11",
    "adm-zip": "^0.5.10",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dropbox": "^10.34.0",
    "electron": "^28.3.3",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.1",
    "googleapis": "^129.0.0",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.1.0",
    "sharp": "^0.33.1",
    "unzipper": "^0.10.14",
    "uuid": "^9.0.1",
    "vm2": "^3.9.19",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  }
}