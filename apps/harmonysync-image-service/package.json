    "@types/uuid": "^9.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "socket.io-client": "^4.8.0",
    "@types/socket.io-client": "^3.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
