// ui/main.slint - Updated with Bible verse functionality
import { VerticalBox, HorizontalBox, Text, Button, Slider, CheckBox, ComboBox, SpinBox, LineEdit, ScrollView, ListView, TabWidget } from "std-widgets.slint";

export struct Track {
    name: string,
    volume: float,
    pan: int, // 0=L, 1=C, 2=R
    mute: bool,
    solo: bool,
    transpose: bool,
}

export struct Slide {
    line1: string,
    line2: string,
}

export struct Song {
    name: string,
    tracks: [Track],
    slides: [Slide],
    metronome: bool,
    config: MixerConfig,
}

export struct MixerConfig {
    transpose_semitones: int,
    low_cut: float,
    high_cut: float,
    limiter_threshold: float,
}

export component MainWindow inherits Window {
    title: "Slint Presenter - Worship & Media Software";
    min-width: 1200px;
    min-height: 800px;
    background: #1a1a1a;
    
    // Properties
    in-out property <[string]> library_model;
    in-out property <[string]> setlist_model;
    in-out property <[string]> popular_verses_model;
    in-out property <[string]> search_results_model;
    in-out property <Song> current_song;
    in-out property <[Slide]> bible_slides;
    in-out property <string> bible_error;
    in-out property <string> current_slide_line1;
    in-out property <string> current_slide_line2;
    in-out property <float> slide_opacity: 1.0;
    in-out property <string> confidence_current_line1;
    in-out property <string> confidence_current_line2;
    in-out property <string> confidence_next_line1;
    in-out property <string> confidence_next_line2;
    in-out property <string> confidence_clock;
    in-out property <string> confidence_countdown;
    in-out property <string> content_type_indicator;
    
    // Callbacks
    callback choose_library_folder();
    callback add_song_to_setlist(string song);
    callback load_song(string song_name);
    callback fetch_bible_verse(string reference, string version);
    callback load_popular_verse(string reference);
    callback search_bible_verses(string keyword);
    callback play_song();
    callback stop_song();
    callback volume_changed(int track_idx, float volume);
    callback pan_changed(int track_idx, int pan);
    callback mute_changed(int track_idx, bool mute);
    callback solo_changed(int track_idx, bool solo);
    callback transpose_changed(int semitones);
    callback low_cut_changed(float value);
    callback high_cut_changed(float value);
    callback limiter_threshold_changed(float value);
    callback metronome_changed(bool enabled);
    callback next_slide();
    callback previous_slide();
    callback jump_to_slide(int slide_idx);
    callback open_display_config();
    callback toggle_audience_screen(bool enabled);
    callback toggle_confidence_monitor(bool enabled);

    HorizontalBox {
        padding: 10px;
        spacing: 10px;

        // Left Panel - Library & Controls
        VerticalBox {
            width: 300px;
            spacing: 10px;
            
            // Library Section
            Rectangle {
                background: #2d2d2d;
                border-radius: 8px;
                padding: 15px;
                
                VerticalBox {
                    spacing: 10px;
                    
                    Text {
                        text: "Library";
                        font-size: 18px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    
                    Button {
                        text: "Choose Library Folder";
                        clicked => { root.choose_library_folder(); }
                    }
                    
                    if library_model.length > 0: ScrollView {
                        height: 150px;
                        ListView {
                            for song in library_model: Rectangle {
                                height: 30px;
                                background: touch_area.has_hover ? #404040 : transparent;
                                border-radius: 4px;
                                
                                HorizontalBox {
                                    padding: 8px;
                                    alignment: space-between;
                                    
                                    Text {
                                        text: song;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                    
                                    Button {
                                        text: "Add";
                                        width: 50px;
                                        height: 25px;
                                        clicked => { root.add_song_to_setlist(song); }
                                    }
                                }
                                
                                TouchArea {
                                    touch_area := TouchArea {
                                        double_clicked => { root.load_song(song); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            
            // Setlist Section
            Rectangle {
                background: #2d2d2d;
                border-radius: 8px;
                padding: 15px;
                
                VerticalBox {
                    spacing: 10px;
                    
                    Text {
                        text: "Setlist";
                        font-size: 18px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    
                    if setlist_model.length > 0: ScrollView {
                        height: 120px;
                        ListView {
                            for song in setlist_model: Rectangle {
                                height: 25px;
                                background: touch_area2.has_hover ? #404040 : transparent;
                                border-radius: 4px;
                                
                                Text {
                                    text: song;
                                    color: #ffffff;
                                    x: 8px;
                                    vertical-alignment: center;
                                }
                                
                                TouchArea {
                                    touch_area2 := TouchArea {
                                        clicked => { root.load_song(song); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            
            // Display Controls
            Rectangle {
                background: #2d2d2d;
                border-radius: 8px;
                padding: 15px;
                
                VerticalBox {
                    spacing: 10px;
                    
                    Text {
                        text: "Display Controls";
                        font-size: 16px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    
                    HorizontalBox {
                        spacing: 10px;
                        Button {
                            text: "Audience Screen";
                            clicked => { root.toggle_audience_screen(true); }
                        }
                        Button {
                            text: "Confidence Monitor";
                            clicked => { root.toggle_confidence_monitor(true); }
                        }
                    }
                    
                    Button {
                        text: "Display Config";
                        clicked => { root.open_display_config(); }
                    }
                }
            }
        }

        // Center Panel - Main Content
        VerticalBox {
            spacing: 10px;
            
            // Tab Widget for different content types
            TabWidget {
                Tab {
                    title: "Songs";
                    
                    VerticalBox {
                        spacing: 10px;
                        
                        // Audio Controls
                        Rectangle {
                            background: #2d2d2d;
                            border-radius: 8px;
                            padding: 15px;
                            
                            VerticalBox {
                                spacing: 10px;
                                
                                HorizontalBox {
                                    spacing: 10px;
                                    alignment: center;
                                    
                                    Button {
                                        text: "Play";
                                        primary: true;
                                        clicked => { root.play_song(); }
                                    }
                                    
                                    Button {
                                        text: "Stop";
                                        clicked => { root.stop_song(); }
                                    }
                                }
                                
                                // Master Controls
                                HorizontalBox {
                                    spacing: 20px;
                                    
                                    VerticalBox {
                                        spacing: 5px;
                                        Text {
                                            text: "Transpose";
                                            color: #ffffff;
                                            font-size: 12px;
                                        }
                                        Slider {
                                            value: root.current_song.config.transpose_semitones;
                                            minimum: -12;
                                            maximum: 12;
                                            width: 100px;
                                            changed => { root.transpose_changed(self.value); }
                                        }
                                    }
                                    
                                    VerticalBox {
                                        spacing: 5px;
                                        Text {
                                            text: "Low Cut";
                                            color: #ffffff;
                                            font-size: 12px;
                                        }
                                        Slider {
                                            value: root.current_song.config.low_cut;
                                            minimum: 20;
                                            maximum: 2000;
                                            width: 100px;
                                            changed => { root.low_cut_changed(self.value); }
                                        }
                                    }
                                    
                                    VerticalBox {
                                        spacing: 5px;
                                        Text {
                                            text: "High Cut";
                                            color: #ffffff;
                                            font-size: 12px;
                                        }
                                        Slider {
                                            value: root.current_song.config.high_cut;
                                            minimum: 2000;
                                            maximum: 20000;
                                            width: 100px;
                                            changed => { root.high_cut_changed(self.value); }
                                        }
                                    }
                                    
                                    VerticalBox {
                                        spacing: 5px;
                                        Text {
                                            text: "Limiter";
                                            color: #ffffff;
                                            font-size: 12px;
                                        }
                                        Slider {
                                            value: root.current_song.config.limiter_threshold;
                                            minimum: 0.1;
                                            maximum: 1.0;
                                            width: 100px;
                                            changed => { root.limiter_threshold_changed(self.value); }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Track Mixer
                        if root.current_song.tracks.length > 0: Rectangle {
                            background: #2d2d2d;
                            border-radius: 8px;
                            padding: 15px;
                            
                            VerticalBox {
                                spacing: 10px;
                                
                                Text {
                                    text: "Track Mixer";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                                
                                ScrollView {
                                    height: 200px;
                                    VerticalBox {
                                        for track[idx] in root.current_song.tracks: Rectangle {
                                            height: 60px;
                                            background: #404040;
                                            border-radius: 4px;
                                            margin: 2px;
                                            
                                            HorizontalBox {
                                                padding: 10px;
                                                spacing: 15px;
                                                alignment: center;
                                                
                                                Text {
                                                    text: track.name;
                                                    color: #ffffff;
                                                    width: 80px;
                                                    font-weight: 600;
                                                }
                                                
                                                // Volume Fader
                                                VerticalBox {
                                                    spacing: 2px;
                                                    Text {
                                                        text: "Vol";
                                                        color: #cccccc;
                                                        font-size: 10px;
                                                    }
                                                    Slider {
                                                        value: track.volume;
                                                        minimum: 0;
                                                        maximum: 1;
                                                        width: 80px;
                                                        changed => { root.volume_changed(idx, self.value); }
                                                    }
                                                }
                                                
                                                // Pan Control
                                                VerticalBox {
                                                    spacing: 2px;
                                                    Text {
                                                        text: "Pan";
                                                        color: #cccccc;
                                                        font-size: 10px;
                                                    }
                                                    ComboBox {
                                                        model: ["L", "C", "R"];
                                                        current_index: track.pan;
                                                        width: 50px;
                                                        selected => { root.pan_changed(idx, self.current_index); }
                                                    }
                                                }
                                                
                                                CheckBox {
                                                    text: "Mute";
                                                    checked: track.mute;
                                                    toggled => { root.mute_changed(idx, self.checked); }
                                                }
                                                
                                                CheckBox {
                                                    text: "Solo";
                                                    checked: track.solo;
                                                    toggled => { root.solo_changed(idx, self.checked); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        if root.current_song.tracks.length == 0: Rectangle {
                            background: #2d2d2d;
                            border-radius: 8px;
                            padding: 20px;
                            
                            Text {
                                text: "No audio files found";
                                color: #888888;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                
                Tab {
                    title: "Bible Verses";
                    
                    VerticalBox {
                        spacing: 10px;
                        
                        // Bible Verse Input
                        Rectangle {
                            background: #2d2d2d;
                            border-radius: 8px;
                            padding: 15px;
                            
                            VerticalBox {
                                spacing: 10px;
                                
                                Text {
                                    text: "Bible Verse Lookup";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                                
                                HorizontalBox {
                                    spacing: 10px;
                                    
                                    LineEdit {
                                        verse_input := LineEdit {
                                            placeholder-text: "e.g., John 3:16 or Romans 8:28-30";
                                            width: 200px;
                                        }
                                    }
                                    
                                    ComboBox {
                                        version_selector := ComboBox {
                                            model: ["NIV", "ESV", "KJV", "NASB", "NLT"];
                                            current_index: 0;
                                            width: 80px;
                                        }
                                    }
                                    
                                    Button {
                                        text: "Fetch Verse";
                                        primary: true;
                                        clicked => { 
                                            root.fetch_bible_verse(verse_input.text, version_selector.current_value); 
                                        }
                                    }
                                }
                                
                                // Search functionality
                                HorizontalBox {
                                    spacing: 10px;
                                    
                                    LineEdit {
                                        search_input := LineEdit {
                                            placeholder-text: "Search by keyword...";
                                            width: 200px;
                                        }
                                    }
                                    
                                    Button {
                                        text: "Search";
                                        clicked => { root.search_bible_verses(search_input.text); }
                                    }
                                }
                                
                                if root.bible_error != "": Text {
                                    text: root.bible_error;
                                    color: #ff6b6b;
                                    font-weight: 600;
                                }
                            }
                        }
                        
                        // Popular Verses
                        Rectangle {
                            background: #2d2d2d;
                            border-radius: 8px;
                            padding: 15px;
                            
                            VerticalBox {
                                spacing: 10px;
                                
                                Text {
                                    text: "Popular Verses";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                                
                                ScrollView {
                                    height: 120px;
                                    VerticalBox {
                                        for verse in root.popular_verses_model: Rectangle {
                                            height: 25px;
                                            background: touch_area3.has_hover ? #404040 : transparent;
                                            border-radius: 4px;
                                            
                                            Text {
                                                text: verse;
                                                color: #ffffff;
                                                x: 8px;
                                                vertical-alignment: center;
                                            }
                                            
                                            TouchArea {
                                                touch_area3 := TouchArea {
                                                    clicked => { root.load_popular_verse(verse); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Search Results
                        if root.search_results_model.length > 0: Rectangle {
                            background: #2d2d2d;
                            border-radius: 8px;
                            padding: 15px;
                            
                            VerticalBox {
                                spacing: 10px;
                                
                                Text {
                                    text: "Search Results";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                                
                                ScrollView {
                                    height: 100px;
                                    VerticalBox {
                                        for result in root.search_results_model: Rectangle {
                                            height: 30px;
                                            background: touch_area4.has_hover ? #404040 : transparent;
                                            border-radius: 4px;
                                            
                                            Text {
                                                text: result;
                                                color: #ffffff;
                                                x: 8px;
                                                vertical-alignment: center;
                                                font-size: 12px;
                                            }
                                            
                                            TouchArea {
                                                touch_area4 := TouchArea {
                                                    // Extract reference from result string
                                                    clicked => { 
                                                        // This would need proper parsing in real implementation
                                                        root.fetch_bible_verse(result, "NIV"); 
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Bible Slides Preview
                        if root.bible_slides.length > 0: Rectangle {
                            background: #2d2d2d;
                            border-radius: 8px;
                            padding: 15px;
                            
                            VerticalBox {
                                spacing: 10px;
                                
                                Text {
                                    text: "Bible Verse Slides";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #ffffff;
                                }
                                
                                ScrollView {
                                    height: 150px;
                                    VerticalBox {
                                        for slide[idx] in root.bible_slides: Rectangle {
                                            height: 50px;
                                            background: touch_area5.has_hover ? #404040 : #353535;
                                            border-radius: 4px;
                                            margin: 2px;
                                            
                                            VerticalBox {
                                                padding: 8px;
                                                spacing: 2px;
                                                
                                                Text {
                                                    text: slide.line1;
                                                    color: #ffffff;
                                                    font-size: 12px;
                                                }
                                                Text {
                                                    text: slide.line2;
                                                    color: #cccccc;
                                                    font-size: 12px;
                                                }
                                            }
                                            
                                            TouchArea {
                                                touch_area5 := TouchArea {
                                                    clicked => { root.jump_to_slide(idx); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                Tab {
                    title: "Media";
                    
                    Rectangle {
                        background: #2d2d2d;
                        border-radius: 8px;
                        padding: 20px;
                        
                        Text {
                            text: "Media functionality coming soon...";
                            color: #888888;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Right Panel - Slide Controls & Preview
        VerticalBox {
            width: 300px;
            spacing: 10px;
            
            // Current Slide Display
            Rectangle {
                background: #2d2d2d;
                border-radius: 8px;
                padding: 15px;
                height: 200px;
                
                VerticalBox {
                    spacing: 10px;
                    
                    HorizontalBox {
                        alignment: space-between;
                        
                        Text {
                            text: "Current Slide";
                            font-size: 16px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        
                        Text {
                            text: root.content_type_indicator;
                            font-size: 12px;
                            color: #888888;
                        }
                    }
                    
                    Rectangle {
                        background: #000000;
                        border-radius: 4px;
                        height: 120px;
                        
                        VerticalBox {
                            padding: 20px;
                            spacing: 10px;
                            alignment: center;
                            
                            Text {
                                text: root.current_slide_line1;
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                opacity: root.slide_opacity;
                            }
                            
                            Text {
                                text: root.current_slide_line2;
                                color: #ffffff;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                opacity: root.slide_opacity;
                            }
                        }
                    }
                    
                    HorizontalBox {
                        spacing: 10px;
                        alignment: center;
                        
                        Button {
                            text: "← Prev";
                            clicked => { root.previous_slide(); }
                        }
                        
                        Button {
                            text: "Next →";
                            primary: true;
                            clicked => { root.next_slide(); }
                        }
                    }
                }
            }
            
            // Confidence Monitor Preview
            Rectangle {
                background: #2d2d2d;
                border-radius: 8px;
                padding: 15px;
                
                VerticalBox {
                    spacing: 10px;
                    
                    Text {
                        text: "Confidence Monitor";
                        font-size: 14px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    
                    HorizontalBox {
                        alignment: space-between;
                        
                        Text {
                            text: "Time:";
                            color: #cccccc;
                            font-size: 12px;
                        }
                        
                        Text {
                            text: root.confidence_clock;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                    
                    Rectangle {
                        background: #404040;
                        border-radius: 4px;
                        height: 60px;
                        
                        VerticalBox {
                            padding: 8px;
                            spacing: 4px;
                            
                            Text {
                                text: "Current:";
                                color: #888888;
                                font-size: 10px;
                            }
                            
                            Text {
                                text: root.confidence_current_line1;
                                color: #ffffff;
                                font-size: 11px;
                            }
                            
                            Text {
                                text: root.confidence_current_line2;
                                color: #ffffff;
                                font-size: 11px;
                            }
                        }
                    }
                    
                    Rectangle {
                        background: #353535;
                        border-radius: 4px;
                        height: 60px;
                        
                        VerticalBox {
                            padding: 8px;
                            spacing: 4px;
                            
                            Text {
                                text: "Next:";
                                color: #888888;
                                font-size: 10px;
                            }
                            
                            Text {
                                text: root.confidence_next_line1;
                                color: #cccccc;
                                font-size: 11px;
                            }
                            
                            Text {
                                text: root.confidence_next_line2;
                                color: #cccccc;
                                font-size: 11px;
                            }
                        }
                    }
                    
                    HorizontalBox {
                        alignment: space-between;
                        
                        Text {
                            text: "Countdown:";
                            color: #cccccc;
                            font-size: 12px;
                        }
                        
                        Text {
                            text: root.confidence_countdown;
                            color: #4ecdc4;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }
}
