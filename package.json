{
  "name": "harmonysync-monorepo",
  "description": "HarmonySync - Modern worship presentation software",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "HarmonySync Team",
  "workspaces": [
    "apps/*",
    "packages/*",
    "harmonysync-core-logic/*"
  ],
  "scripts": {
    "dev": "concurrently -k -s first -n renderer,electron \"pnpm --filter @harmonysync/renderer dev\" \"pnpm --filter @harmonysync/electron-app dev\"",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}