{
  "name": "harmonysync-electron",
  "version": "1.0.0",
  "description": "HarmonySync Presenter - Electron/Node.js version",
  "main": "electron/dist/main.js",
  "scripts": {
    "start": "npm run build:electron && electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "cd harmonysync && npm run dev",
    "dev:electron": "wait-on http://localhost:5174 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build:electron": "tsc --project electron/tsconfig.json",
    "build": "cd harmonysync && npm run build && electron-builder",
    "build:win": "npm run build -- --win",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux",
    "audio-service": "cd harmonysync-audio-service && npm start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "npm run typecheck:electron && npm run typecheck:frontend",
    "typecheck:electron": "tsc --noEmit --project electron/tsconfig.json",
    "typecheck:frontend": "tsc --noEmit --project harmonysync/tsconfig.json",
    "typecheck:electron:watch": "tsc --noEmit --watch --project electron/tsconfig.json",
    "lint:types": "npm run typecheck"
  },
  "keywords": [
    "worship",
    "presenter",
    "media",
    "audio",
    "multitrack"
  ],
  "author": "HarmonySync Team",
  "license": "MIT",
  "workspaces": [
    "harmonysync"
  ],
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dropbox": "^10.34.0",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.1",
    "googleapis": "^128.0.0",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.33.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1",
    "uuid": "^9.0.1",
    "vm2": "^3.9.19"
  },
  "optionalDependencies": {
    "midi": "^2.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.30",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^40.1.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest",
    "testTimeout": 10000,
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.js"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "collectCoverageFrom": [
      "electron/services/**/*.ts",
      "!electron/services/__tests__/**",
      "!electron/services/**/*.d.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "esModuleInterop": true,
          "allowSyntheticDefaultImports": true
        }
      }
    }
  },
  "build": {
    "appId": "com.harmonysync.app",
    "productName": "HarmonySync",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "harmonysync/dist/**/*",
      "harmonysync-audio-service/**/*",
      "!harmonysync-audio-service/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "harmonysync-audio-service",
        "to": "audio-service",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    }
  }
}
