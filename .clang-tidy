# Applied as warnings everywhere; only paths in tools/quality/lint-scope.txt are enforced in CI.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  performance-*,
  -performance-enum-size,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-scoped-lock,
  -modernize-use-ranges,
  -modernize-raw-string-literal,
  -modernize-use-nodiscard,
  -modernize-use-designated-initializers,
  -modernize-avoid-c-arrays,
  -modernize-return-braced-init-list,
  -modernize-loop-convert,
  -bugprone-throwing-static-initialization,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  misc-redundant-expression,
  misc-unused-parameters,
  readability-braces-around-statements,
  readability-container-size-empty,
  readability-else-after-return,
  readability-misleading-indentation,
  readability-redundant-*
# Excludes vendored qrcodegen (lowercase 'q'); all first-party services start uppercase.
HeaderFilterRegex: 'src/(core/models/|core/services/[^q]|media/|viewmodels/)'
CheckOptions:
  # Non-copyable interfaces and services don't need explicit move members.
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
FormatStyle: file
