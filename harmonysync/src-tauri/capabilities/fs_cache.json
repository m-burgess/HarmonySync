{
  "identifier": "fs-cache-capability",
  "description": "Capability for unrestricted file system access.",
  "windows": ["main"],
  "permissions": [
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file", 
    "fs:allow-write-file",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-rename"
  ]
}