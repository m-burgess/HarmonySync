{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "harmonysync",
  "version": "0.1.0",
  "identifier": "com.harmonysync.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "harmonysync",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      },
      {
        "label": "audience",
        "url": "audience.html",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "title": "Audience Screen",
        "devtools": false,
        "visible": false,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "confidence",
        "url": "confidence.html",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "title": "Confidence Monitor",
        "devtools": true,
        "visible": false,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "lowerthirds",
        "url": "lowerthirds.html",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "title": "Lower Thirds",
        "devtools": false,
        "visible": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost https://i.ytimg.com https://*.ytimg.com; frame-src 'self' https://www.youtube.com https://youtube.com; media-src 'self' asset: http://asset.localhost https://*.googlevideo.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.youtube.com https://youtube.com; style-src 'self' 'unsafe-inline' https://www.youtube.com; connect-src 'self' asset: http://asset.localhost ipc: http://ipc.localhost https://www.youtube.com https://*.googlevideo.com https://youtube.com",
      "capabilities": ["main-capability", "fs-cache-capability", "event-capability"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/**",
          "$DESKTOP/**", 
          "$HOME/Desktop/**",
          "$DOWNLOAD/**",
          "$HOME/Downloads/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}