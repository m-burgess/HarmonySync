{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "harmonysync",
  "version": "0.1.0",
  "identifier": "com.harmonysync.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "harmonysync",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      },
      {
        "label": "audience",
        "url": "audience.html",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "title": "Audience Screen",
        "devtools": true,
        "visible": false
      },
      {
        "label": "confidence",
        "url": "confidence.html",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "title": "Confidence Monitor",
        "devtools": true,
        "visible": false
      },
      {
        "label": "lowerthirds",
        "url": "lowerthirds.html",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "fullscreen": false,
        "title": "Lower Thirds",
        "devtools": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "capabilities": ["main-capability", "fs-cache-capability", "event-capability"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}