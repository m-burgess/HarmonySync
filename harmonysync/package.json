{
  "name": "harmonysync",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "npm run dev",
    "launch:nosandbox": "./scripts/launch-harmonysync.sh"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.27",
    "tailwindcss": "^4.1.14",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.6.5",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.1",
    "googleapis": "^128.0.0",
    "midi": "^2.0.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^7.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-window": "^1.8.7",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.harmonysync.app",
    "productName": "HarmonySync",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["deb", "rpm", "AppImage"],
      "category": "AudioVideo"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
